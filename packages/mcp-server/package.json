{
  "name": "@settle/mcp-server",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "bin": { "settle-mcp": "./dist/main.js" },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
