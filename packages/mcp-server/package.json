    "@modelcontextprotocol/sdk": "1.32.1",
    "@settle/agent-sdk": "workspace:*",
    "zod": "3.25.76"
  },
  "devDependencies": {
    "@settle/api": "workspace:*",
    "@settle/domain": "workspace:*",
    "@settle/fixture-api": "workspace:*",
    "@types/node": "22.9.0",
    "near-api-js": "7.3.1",
    "typescript": "5.6.3",
    "vitest": "2.1.5"
  }
}
