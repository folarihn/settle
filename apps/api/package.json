{
  "name": "@settle/api",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "start": "node dist/main.js",
    "worker": "node dist/worker-main.js"
  },
  "dependencies": {
    "@electric-sql/pglite": "0.5.10",
    "@fastify/static": "10.1.6",
    "@settle/domain": "workspace:*",
    "@settle/fixture-api": "workspace:*",
    "@settle/verifier": "workspace:*",
    "fastify": "5.12.7",
    "near-api-js": "7.3.1",
    "pg": "8.23.1",
    "zod": "3.23.8",
    "@settle/near-ai": "workspace:*"
  },
  "devDependencies": {
    "@types/node": "22.9.0",
    "@types/pg": "8.23.1",
    "typescript": "5.6.3",
    "vitest": "2.1.5"
  }
}
